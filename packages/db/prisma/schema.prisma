generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  vendor
  admin
}

enum UserStatus {
  active
  banned
}

enum VendorStatus {
  pending
  approved
  suspended
}

enum ProductStatus {
  draft
  active
  archived
}

enum OrderStatus {
  pending_payment
  paid
  processing
  completed
  cancelled
  refunded
}

enum VendorOrderStatus {
  awaiting_payment
  paid
  fulfilling
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  requires_action
  succeeded
  failed
  cancelled
  refunded
}

enum TransferStatus {
  pending
  paid
  failed
}

enum VendorLedgerKind {
  refund_debt
  debt_offset
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String?
  role         Role       @default(customer)
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  vendorProfile       VendorProfile?
  auditLogs           AuditLog[]
  cart                Cart?
  addresses           Address[]
  orders              Order[]
  reviews             Review[]
  aiGenerations       AiGeneration[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model PlatformSettings {
  id                        String   @id @default(uuid()) @db.Uuid
  commissionBps             Int      @default(1000) @map("commission_bps")
  currency                  String   @default("USD")
  debtReviewThresholdCents  Int      @default(10000) @map("debt_review_threshold_cents")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model VendorProfile {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @unique @map("user_id") @db.Uuid
  displayName          String       @map("display_name")
  slug                 String       @unique
  bio                  String?
  logoUrl              String?      @map("logo_url")
  bannerUrl            String?      @map("banner_url")
  city                 String?
  craftTags            String[]     @default([]) @map("craft_tags")
  status               VendorStatus @default(pending)
  ledgerReviewRequired Boolean      @default(false) @map("ledger_review_required")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop          Shop?
  stripeAccount StripeAccount?
  vendorOrders  VendorOrder[]
  ledgerEntries VendorLedgerEntry[]

  @@map("vendor_profiles")
}

model Shop {
  id                   String   @id @default(uuid()) @db.Uuid
  vendorId             String   @unique @map("vendor_id") @db.Uuid
  shippingPolicy       String?  @map("shipping_policy")
  returnsPolicy        String?  @map("returns_policy")
  flatShippingCents    Int      @default(0) @map("flat_shipping_cents")
  shipsFromCity        String?  @map("ships_from_city")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  vendor  VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products Product[]
  media    Media[]

  @@map("shops")
}

model StripeAccount {
  id                 String   @id @default(uuid()) @db.Uuid
  vendorId           String   @unique @map("vendor_id") @db.Uuid
  stripeAccountId    String?  @unique @map("stripe_account_id")
  onboardingComplete Boolean  @default(false) @map("onboarding_complete")
  chargesEnabled     Boolean  @default(false) @map("charges_enabled")
  payoutsEnabled     Boolean  @default(false) @map("payouts_enabled")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("stripe_accounts")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  shopId      String        @map("shop_id") @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  title       String
  slug        String
  description String        @default("")
  status      ProductStatus @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  media    Media[]
  reviews  Review[]
  embedding ProductEmbedding?

  @@unique([shopId, slug])
  @@index([status])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  sku        String?
  priceCents Int      @map("price_cents")
  currency   String   @default("USD")
  stockQty   Int      @default(0) @map("stock_qty")
  attributes Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  reservations  InventoryReservation[]

  @@index([productId])
  @@map("product_variants")
}

model Media {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String?  @map("product_id") @db.Uuid
  shopId     String?  @map("shop_id") @db.Uuid
  storageKey String   @map("storage_key")
  url        String
  alt        String   @default("")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop    Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([shopId])
  @@map("media")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @unique @map("user_id") @db.Uuid
  sessionId String?  @unique @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  name       String
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String   @map("postal_code")
  country    String   @default("US")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  buyerId              String      @map("buyer_id") @db.Uuid
  status               OrderStatus @default(pending_payment)
  currency             String      @default("USD")
  itemsSubtotalCents   Int         @map("items_subtotal_cents")
  shippingTotalCents   Int         @map("shipping_total_cents")
  totalCents           Int         @map("total_cents")
  commissionTotalCents Int         @default(0) @map("commission_total_cents")
  idempotencyKey       String?     @unique @map("idempotency_key")
  shipName             String      @map("ship_name")
  shipLine1            String      @map("ship_line1")
  shipLine2            String?     @map("ship_line2")
  shipCity             String      @map("ship_city")
  shipRegion           String?     @map("ship_region")
  shipPostalCode       String      @map("ship_postal_code")
  shipCountry          String      @default("US") @map("ship_country")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  buyer         User                    @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  vendorOrders  VendorOrder[]
  payment       Payment?
  reservations  InventoryReservation[]

  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

model VendorOrder {
  id                 String            @id @default(uuid()) @db.Uuid
  orderId            String            @map("order_id") @db.Uuid
  vendorId           String            @map("vendor_id") @db.Uuid
  status             VendorOrderStatus @default(awaiting_payment)
  itemsSubtotalCents Int               @map("items_subtotal_cents")
  shippingCents      Int               @map("shipping_cents")
  commissionBps      Int               @map("commission_bps")
  commissionCents    Int               @map("commission_cents")
  vendorNetCents     Int               @map("vendor_net_cents")
  trackingNumber     String?           @map("tracking_number")
  carrier            String?
  fulfillingAt       DateTime?         @map("fulfilling_at")
  shippedAt          DateTime?         @map("shipped_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  transfer Transfer?

  @@index([orderId])
  @@index([vendorId])
  @@index([status])
  @@map("vendor_orders")
}

model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  vendorOrderId   String   @map("vendor_order_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid
  productId       String?  @map("product_id") @db.Uuid
  title           String
  productSlug     String   @map("product_slug")
  sku             String?
  unitPriceCents  Int      @map("unit_price_cents")
  quantity        Int
  lineTotalCents  Int      @map("line_total_cents")
  attributes      Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([vendorOrderId])
  @@map("order_items")
}

model InventoryReservation {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([orderId, variantId])
  @@index([expiresAt])
  @@index([variantId])
  @@map("inventory_reservations")
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  orderId            String        @unique @map("order_id") @db.Uuid
  provider           String        @default("stripe")
  status             PaymentStatus @default(pending)
  amountCents        Int           @map("amount_cents")
  applicationFeeCents Int          @default(0) @map("application_fee_cents")
  currency           String        @default("USD")
  checkoutSessionId  String?       @unique @map("checkout_session_id")
  paymentIntentId    String?       @unique @map("payment_intent_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PaymentEvent {
  id            String   @id @default(uuid()) @db.Uuid
  stripeEventId String   @unique @map("stripe_event_id")
  type          String
  payload       Json     @default("{}")
  processedAt   DateTime @default(now()) @map("processed_at")

  @@index([type])
  @@map("payment_events")
}

model Transfer {
  id               String         @id @default(uuid()) @db.Uuid
  vendorOrderId    String         @unique @map("vendor_order_id") @db.Uuid
  stripeTransferId String?        @unique @map("stripe_transfer_id")
  amountCents      Int            @map("amount_cents")
  currency         String         @default("USD")
  status           TransferStatus @default(pending)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@map("transfers")
}

/// Vendor payout ledger: refund_debt after money already transferred; debt_offset when
/// later transfers are reduced to recover that debt (Amazon-style netting).
model VendorLedgerEntry {
  id            String           @id @default(uuid()) @db.Uuid
  vendorId      String           @map("vendor_id") @db.Uuid
  kind          VendorLedgerKind
  amountCents   Int              @map("amount_cents")
  currency      String           @default("USD")
  orderId       String?          @map("order_id") @db.Uuid
  vendorOrderId String?          @map("vendor_order_id") @db.Uuid
  note          String?
  createdAt     DateTime         @default(now()) @map("created_at")

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([kind])
  @@index([orderId])
  @@map("vendor_ledger_entries")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id")
  meta      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model Review {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  rating           Int
  body             String   @default("")
  verifiedPurchase Boolean  @default(false) @map("verified_purchase")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

enum EmailStatus {
  pending
  sent
  failed
}

model EmailOutbox {
  id        String      @id @default(uuid()) @db.Uuid
  toEmail   String      @map("to_email")
  subject   String
  template  String
  payload   Json        @default("{}")
  status    EmailStatus @default(pending)
  error     String?
  sentAt    DateTime?   @map("sent_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([status])
  @@index([template])
  @@map("email_outbox")
}

/** Phase 6.5 — product text embeddings (JSON float[]; cosine in app; pgvector optional later). */
model ProductEmbedding {
  productId   String   @id @map("product_id") @db.Uuid
  vector      Json
  model       String   @default("mock-bow-v1")
  contentHash String   @map("content_hash")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([model])
  @@map("product_embeddings")
}

model AiGeneration {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  kind       String
  promptMeta Json     @default("{}") @map("prompt_meta")
  output     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([kind])
  @@map("ai_generations")
}
