# Database
DATABASE_URL=postgresql://crafthub:crafthub@localhost:5432/crafthub?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Apps
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Stripe (Phase 3 — placeholders)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Media (Phase 1)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email (Phase 6)
EMAIL_FROM=CraftHub <noreply@crafthub.local>
RESEND_API_KEY=

# Observability
SENTRY_DSN=

# Platform
COMMISSION_BPS=1000
NODE_ENV=development
