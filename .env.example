# Database
DATABASE_URL=postgresql://crafthub:crafthub@localhost:5432/crafthub?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Apps
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Stripe (Phase 3)
# Leave STRIPE_SECRET_KEY empty (or set E2E_STRIPE_MOCK=1) to use the mock adapter for local/e2e.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
E2E_STRIPE_MOCK=1
RESERVATION_TTL_MINUTES=30

# Media (Phase 1)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email (Phase 6)
EMAIL_FROM=CraftHub <noreply@crafthub.local>
RESEND_API_KEY=

# Observability
SENTRY_DSN=

# AI (Phase 6.5)
# Preferred free chat: Groq — https://console.groq.com/keys
# Embeddings stay mock unless OPENAI_API_KEY is set (Groq has no embeddings API).
# E2E_AI_MOCK=1 forces templated replies (for tests). Set to 0 to use Groq/OpenAI.
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
E2E_AI_MOCK=1
AI_RATE_LIMIT_PER_MIN=30
AI_MAX_TOKENS=600

# Platform
COMMISSION_BPS=1000
NODE_ENV=development
